// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id            String   @id @default(uuid())
  email         String   @unique // O e-mail deve ser único para login
  name          String
  password_hash String // O hash da senha, nunca a senha em texto plano
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  categories         category[] // Relacionamento One-to-Many
  expenses           expense[] // Relacionamento One-to-Many
  recurring_expenses recurring_expense[] // Relacionamento One-to-Many

  @@map("users")
}

// Model for 'Category'
// Um Agregado que agora pertence a um usuário.
model category {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  user_id            String
  user               user                @relation(fields: [user_id], references: [id])
  expenses           expense[]
  recurring_expenses recurring_expense[]

  @@unique([name, user_id])
  @@map("categories")
}

// Model for 'Expense'
// Um Agregado que agora pertence a um usuário.
model expense {
  id                   String             @id @default(uuid())
  description          String
  amount               Decimal            @db.Decimal(10, 2)
  date                 DateTime           @default(now())
  notes                String?
  category_id          String
  category             category           @relation(fields: [category_id], references: [id])
  recurring_expense_id String?
  recurring_expense    recurring_expense? @relation(fields: [recurring_expense_id], references: [id])
  user_id              String
  user                 user               @relation(fields: [user_id], references: [id])

  @@index([date, category_id, user_id])
  @@map("expenses")
}

model recurring_expense {
  id                 String    @id @default(uuid())
  description        String
  amount             Decimal   @db.Decimal(10, 2)
  frequency          frequency @default(monthly)
  start_date         DateTime
  end_date           DateTime?
  category_id        String
  category           category  @relation(fields: [category_id], references: [id])
  user_id            String
  user               user      @relation(fields: [user_id], references: [id])
  generated_expenses expense[]

  @@index([frequency, start_date, user_id])
  @@map("recurring_expenses")
}

enum frequency {
  daily
  weekly
  monthly
  yearly
  custom
}
